{
  "Urls": "http://127.0.0.1:8788",
  "Scanner": {
    "OcrEngine": "auto",
    "TesseractExecutable": "tesseract",
    "TesseractLanguages": "eng",
    "UmiUrl": "http://127.0.0.1:1224/api/ocr",
    "Hotkeys": true,
    "HotkeyKeys": {
      "Capture": "Ctrl+Alt+S",
      "Scroll": "Ctrl+Alt+W",
      "Stop": "Ctrl+Alt+Q",
      "Region": "Ctrl+Alt+R"
    },
    "CaptureFocusDelayMs": 3000,
    "ScrollStabilityWaitMs": 2000
  },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  }
}
